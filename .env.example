# Speak — server-side configuration.
#
# Copy to `.env.local` and fill in. `.env*` is gitignored, so `.env.local`
# cannot be committed by accident.
#
# None of these are prefixed `NEXT_PUBLIC_`, and none of them ever should be:
# that prefix inlines a value into the browser bundle, which for an API key
# means publishing it.

# Which evaluator backs /api/analyze. Leave unset and the key decides: present
# means real analysis, absent means sample scores. Set it only to override —
#   mock       — sample scores, no model, even if a key is present
#   anthropic  — real analysis, and fail loudly if the key is missing
# SPEAK_AI_PROVIDER=

# The only line you need. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
# SPEAK_AI_MODEL=claude-sonnet-5

# The design system page is a private workbench — unfinished states, every
# component out of context. Set to 1 to reach it; anything else and the route
# 404s and its tab does not render. Defaults to hidden.
SPEAK_SHOW_DESIGN_SYSTEM=1
