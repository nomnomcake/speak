# Speak — server-side configuration.
#
# Copy to `.env.local` and fill in. `.env*` is gitignored, so `.env.local`
# cannot be committed by accident.
#
# None of these are prefixed `NEXT_PUBLIC_`, and none of them ever should be:
# that prefix inlines a value into the browser bundle, which for an API key
# means publishing it.

# Which evaluator backs /api/analyze.
#   mock       — sample scores, no model, no key needed (the default)
#   anthropic  — real analysis, requires ANTHROPIC_API_KEY below
SPEAK_AI_PROVIDER=anthropic

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
# SPEAK_AI_MODEL=claude-sonnet-5
